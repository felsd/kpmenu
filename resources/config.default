# This is the default config of kpmenu
# You can store it into $HOME/.config/kpmenu/config
[general]
UseRofi = false
ClipboardTool = "xsel"
ClipboardTimeout = 15
NoCache = false
CacheOneTime = false
# CacheTimeout is a sliding-window idle timeout. Every successful access
# resets the timer; the daemon exits and the master password is required
# again after this many seconds of inactivity.
CacheTimeout = 300
ShowNotifications = true
# DoNotShowMenu skips the top-level Show/Reload/Exit selection and goes
# straight to the entry picker. The field picker (Password/UserName/URL)
# always runs, so the user still confirms each lookup interactively.
# Only safe in trusted single-user contexts.
DoNotShowMenu = true
RememberLastEntry = true
ArgsSeparator = "|"
NoOTP = false

[style]
PasswordBackground = "black"
TextPassword = "Enter password"
TextMenu = "Select"
TextEntry = "Entry"
TextField = "Field"
FormatEntry = "{Title} - {UserName}"
ArgsPassword = "-fn|'xft:SauceCodePro Nerd Font:pixelsize=20:antialias=true:hinting=true'"
ArgsMenu = "-fn|'xft:SauceCodePro Nerd Font:pixelsize=20:antialias=true:hinting=true'"
ArgsEntry = "-fn|'xft:SauceCodePro Nerd Font:pixelsize=20:antialias=true:hinting=true'"
ArgsField = "-fn|'xft:SauceCodePro Nerd Font:pixelsize=20:antialias=true:hinting=true'"

[database]
Database = "XXX.kdbx"
#KeyFile =
#Password =
FieldOrder = "Password UserName URL"
FillOtherFields = true
#FillBlacklist =
